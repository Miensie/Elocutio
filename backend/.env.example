PORT=3000

# Ces deux valeurs sont publiques (identiques à celles du frontend)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# SECRÈTE — jamais exposée au frontend, jamais commit. Récupérable dans
# Supabase > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

AI_PROVIDER=gemini
# SECRÈTE — jamais exposée au frontend, jamais commit.
GEMINI_API_KEY=your-gemini-api-key

# Origine(s) autorisée(s) pour CORS, séparées par des virgules si plusieurs.
# En local : http://localhost:5173
# En prod (GitHub Pages) : https://votre-username.github.io
CORS_ORIGIN=http://localhost:5173,https://votre-username.github.io
